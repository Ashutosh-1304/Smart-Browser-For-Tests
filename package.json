{
  "name": "secure-assessment-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Assessment Application - PoC (Electron + React + MediaPipe Face Detection)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 tcp:127.0.0.1:3001 && electron .",
    "dev": "concurrently -k -n SERVER,VITE,ELECTRON -c magenta,cyan,green \"npm:dev:server\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "test:server": "DATABASE_PATH=:memory: node --test server/tests/api.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.20",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
